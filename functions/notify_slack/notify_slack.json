{
	"name": "notify_slack",
	"description": "Sends credential expiry notifications to Slack channel",
	"type": "API",
	"visibility": "POD",
	"code": { "$file": "code.py" },
	"permissions": {
		"grants": [
			{
				"resource_type": "datastore_table",
				"resource_name": "credentials",
				"permission_ids": ["datastore.table.read", "datastore.record.read"]
			},
			{
				"resource_type": "datastore_table",
				"resource_name": "audit_log",
				"permission_ids": ["datastore.table.read", "datastore.record.read", "datastore.record.write"]
			},
			{
				"resource_type": "datastore_table",
				"resource_name": "webhook_config",
				"permission_ids": ["datastore.table.read", "datastore.record.read"]
			}
		]
	}
}
