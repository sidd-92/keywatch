{
"name": "credentials",
"primary_key_column": "id",
"enable_rls": false,
"visibility": "POD",
"columns": [
{ "name": "name", "type": "TEXT", "required": true, "max_length": 240 },
{
"name": "provider",
"type": "ENUM",
"required": true,
"default": "stripe",
"options": ["stripe", "resend", "github", "aws"]
},
{ "name": "key_hint", "type": "TEXT", "required": false, "max_length": 20 },
{ "name": "expiry_date", "type": "DATE", "required": true },
{
"name": "status",
"type": "ENUM",
"required": true,
"default": "active",
"options": ["active", "warning", "critical", "rotated"]
},
{ "name": "last_rotated", "type": "DATE", "required": false },
{ "name": "vault_reference", "type": "TEXT", "required": false, "max_length": 240 },
{ "name": "owner_slack", "type": "TEXT", "required": false, "max_length": 100 },
{ "name": "notify_slack_enabled", "type": "BOOLEAN", "required": false, "default": true },
{ "name": "notify_discord_enabled", "type": "BOOLEAN", "required": false, "default": true },
{ "name": "discord_handle", "type": "TEXT", "required": false, "max_length": 100 },
{ "name": "notes", "type": "TEXT", "required": false }
],
"config": {}
}
