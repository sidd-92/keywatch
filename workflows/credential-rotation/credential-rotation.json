{
	"name": "credential-rotation",
	"description": "Orchestrates credential expiry detection, Slack notification, approval and rotation",
	"start": { "type": "MANUAL" },
	"visibility": "POD",
	"nodes": [
		{
			"id": "intake",
			"type": "FORM",
			"label": "Credential to Rotate",
			"config": {
				"input_schema": {
					"type": "object",
					"properties": {
						"credential_name": { "type": "string" }
					},
					"required": ["credential_name"]
				}
			}
		},
		{
			"id": "check_credential",
			"type": "FUNCTION",
			"label": "Check Credential Exists",
			"config": {
				"function_name": "check_credential",
				"input_mapping": {
					"credential_name": { "type": "expression", "value": "intake.credential_name" }
				}
			}
		},
		{
			"id": "route_found",
			"type": "DECISION",
			"label": "Credential Found?",
			"config": {
				"rules": [{ "condition": "check_credential.found == `true`", "next_node_id": "notify" }]
			}
		},
		{
			"id": "notify",
			"type": "FUNCTION",
			"label": "Notify Slack",
			"config": {
				"function_name": "notify_slack",
				"input_mapping": {
					"credential_name": { "type": "expression", "value": "check_credential.credential_name" }
				}
			}
		},
		{
			"id": "approval",
			"type": "FORM",
			"label": "Approve Rotation",
			"config": {
				"input_schema": {
					"type": "object",
					"properties": {
						"approved": {
							"type": "boolean",
							"description": "Approve rotation of this credential?",
							"default": false
						},
						"notes": {
							"type": "string",
							"description": "Any notes for the audit log"
						}
					},
					"required": []
				}
			}
		},
		{
			"id": "check_approval",
			"type": "DECISION",
			"label": "Approved?",
			"config": {
				"rules": [{ "condition": "approval.approved == `true`", "next_node_id": "end" }]
			}
		},
		{
			"id": "end_not_found",
			"type": "END",
			"label": "Credential Not Found"
		},
		{
			"id": "end",
			"type": "END",
			"label": "Rotation Complete"
		},
		{
			"id": "end_rejected",
			"type": "END",
			"label": "Rotation Rejected"
		}
	],
	"edges": [
		{ "id": "e1", "source": "intake", "target": "check_credential" },
		{ "id": "e2", "source": "check_credential", "target": "route_found" },
		{ "id": "e3", "source": "route_found", "target": "end_not_found" },
		{ "id": "e4", "source": "route_found", "target": "notify" },
		{ "id": "e5", "source": "notify", "target": "approval" },
		{ "id": "e6", "source": "approval", "target": "check_approval" },
		{ "id": "e7", "source": "check_approval", "target": "end_rejected" },
		{ "id": "e8", "source": "check_approval", "target": "end" }
	]
}
